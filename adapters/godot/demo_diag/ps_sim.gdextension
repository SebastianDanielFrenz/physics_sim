[configuration]

entry_symbol = "ps_godot_library_init"
compatibility_minimum = "4.5"
compatibility_maximum = "4.7"

[libraries]

windows.debug.x86_64 = "res://bin/libps_godot.dll"
windows.release.x86_64 = "res://bin/libps_godot.dll"
linux.debug.x86_64 = "res://bin/libps_godot.so"
linux.release.x86_64 = "res://bin/libps_godot.so"

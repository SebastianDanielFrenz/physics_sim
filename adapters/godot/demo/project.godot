; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited using the UI.
;
; PLAN.md P2 demo project: flat test ground, free camera, debug draw,
; on-screen readout, world-space speed grid shader, Xbox/keyboard input.

config_version=5

[application]

config/name="physics_sim P2 demo"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon=""

